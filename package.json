{
  "name": "overlay-browser",
  "version": "1.0.0-beta.3",
  "description": "Overlay browser shown and hidden with a keyboard shortcut",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:store": "electron-builder --win appx",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "keywords": [],
  "author": "Fabrizio Di Giuseppe",
  "license": "Apache-2.0",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "it.fdg.overlay-browser",
    "productName": "Overlay Browser",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "platform/**/*",
      "index.html",
      "locales/**/*",
      "lists/**/*.json",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "appx": {
      "identityName": "FabrizioDiGiuseppe.overlaybrowser",
      "publisher": "CN=F4A96C79-99CB-40F5-86E9-BAF8F73389BF",
      "publisherDisplayName": "Fabrizio Di Giuseppe",
      "displayName": "overlay browser",
      "applicationId": "OverlayBrowser",
      "languages": [
        "en-US",
        "it-IT",
        "de-DE",
        "es-ES",
        "fr-FR",
        "pt-BR",
        "ru-RU"
      ],
      "artifactName": "${productName}-Store-${version}.${ext}"
    }
  },
  "dependencies": {
    "koffi": "^3.3.7",
    "uiohook-napi": "^1.5.5"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "uiohook-napi@1.5.5": true,
    "koffi@3.3.8": true
  }
}
